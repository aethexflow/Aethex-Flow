{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user's non-PII workspace profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["member", "operator"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document strictly accessible only by the account owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 254 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ChatMessageRecord": {
      "title": "ChatMessageRecord",
      "description": "Persisted Ask Aethe Copilot conversation turn per user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 12000 },
        "suggestedTool": { "type": "string", "maxLength": 64 },
        "videoInstruction": { "type": "string", "maxLength": 1000 },
        "engine": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "role", "content", "createdAt"]
    },
    "SavedWorkflow": {
      "title": "SavedWorkflow",
      "description": "Per-user saved reusable DAG workflow template stored with native Firestore maps.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 40 },
        "tags": { "type": "array" },
        "nodesCount": { "type": "number" },
        "edgesCount": { "type": "number" },
        "graph": { "type": "object" },
        "samplePayload": { "type": "object" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "name", "description", "nodesCount", "edgesCount", "graph", "isPublic", "createdAt", "updatedAt"]
    },
    "PublicWorkflow": {
      "title": "PublicWorkflow",
      "description": "Publicly shared reusable community DAG workflow template published by any authenticated user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 40 },
        "tags": { "type": "array" },
        "graph": { "type": "object" },
        "samplePayload": { "type": "object" },
        "runsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorUid", "authorName", "name", "description", "category", "graph", "runsCount", "createdAt", "updatedAt"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "User-scoped workspace activity audit item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "action", "status", "createdAt"]
    },
    "UserWorkspacePreference": {
      "title": "UserWorkspacePreference",
      "description": "Synced theme, pinned tools, and layout density per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "pinnedToolIds": { "type": "array" },
        "density": { "type": "string", "enum": ["comfortable", "compact"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "theme", "pinnedToolIds", "density", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User's own non-PII workspace profile document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII record (email) readable/writable solely by owner."
    },
    "/users/{userId}/chats/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessageRecord" },
      "description": "User's persisted AI Chat Assistant conversation history."
    },
    "/users/{userId}/workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/SavedWorkflow" },
      "description": "User's saved Workflow DAG graphs."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityRecord" },
      "description": "User's recent activity history."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserWorkspacePreference" },
      "description": "User's synced workspace theme, pinned tools, and layout density."
    },
    "/publicWorkflows/{workflowId}": {
      "schema": { "$ref": "#/entities/PublicWorkflow" },
      "description": "Community-shared DAG workflows readable by all visitors and writable by owners."
    }
  }
}
